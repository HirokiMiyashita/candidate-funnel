# `npm run db:status` (supabase status) の出力からコピーしてください
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key（古い CLI では "anon key" と表示されます。どちらでも可）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key（サーバー専用。LP の応募保存に使用）。NEXT_PUBLIC_ を付けないこと
SUPABASE_SECRET_KEY=
# 確認メールのリダイレクト先の基点（Origin ヘッダーが取れない場合のみ使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 管理画面の URL のパス（/<この値>/login で管理画面に入る）。
# 推測されにくい値にし、環境ごとに変えること。サーバー側のみで使用（NEXT_PUBLIC_ を付けない）
# 生成例: echo "admin-$(openssl rand -hex 12)"
ADMIN_PATH_SEGMENT=
